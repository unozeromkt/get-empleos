# ═══════════════════════════════════════════════════
# GetEmpleos — Variables de entorno
# Copia este archivo como .env.local y completa los valores
# ═══════════════════════════════════════════════════

# ─── Supabase ────────────────────────────────────────
# Obtén estos valores en: https://app.supabase.com → Tu proyecto → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Acepta tanto la anon key clásica (eyJ...) como la nueva "publishable key"
# de Supabase (sb_publishable_...) — son intercambiables en este parámetro.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# NUNCA exponer este valor al cliente — solo para Server Actions y rutas de API
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Sitio ───────────────────────────────────────────
# DESARROLLO:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# PRODUCCIÓN (cambiar en Vercel Environment Variables):
# NEXT_PUBLIC_SITE_URL=https://get-empleos.vercel.app

# IMPORTANTE — también configurar en Supabase Dashboard:
# Authentication → URL Configuration
#   Site URL:       https://get-empleos.vercel.app
#   Redirect URLs:  https://get-empleos.vercel.app/auth/callback

# ─── Resend (emails transaccionales) ─────────────────
# Obtén tu API key en: https://resend.com/api-keys

RESEND_API_KEY=re_...

# Dominio verificado en Resend
RESEND_FROM_EMAIL=empleos@getcompany.co

# ─── IA: screening y creación de ofertas ─────────────
# Sin OPENAI_API_KEY o con AI_ENABLED=false, el módulo queda inerte y la
# plataforma funciona exactamente igual que antes.

OPENAI_API_KEY=sk-...
AI_ENABLED=true

# Proveedor y modelo. Cambiar de proveedor solo requiere implementar la
# interfaz de lib/ai/provider.ts y registrarla en lib/ai/providers/index.ts
AI_PROVIDER=openai
AI_EXTRACTION_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Timeout del cliente, por debajo del límite de la función serverless:
# preferimos fallar limpio a que Vercel corte la ejecución a mitad
AI_REQUEST_TIMEOUT_MS=50000

# Vercel Hobby: 1 run por invocación, con el cron disparando cada minuto
AI_WORKER_BATCH_SIZE=1
AI_MAX_DOCUMENT_CHARS=60000

# Tope de gasto diario. Al alcanzarlo el worker deja de procesar.
AI_DAILY_COST_LIMIT_USD=25

# Protege /api/cron/ai-worker. Debe coincidir con el secreto 'ai_worker_secret'
# guardado en Supabase Vault (ver migración 011).
CRON_SECRET=

# ─── Feature flags del módulo de IA ──────────────────
FEATURE_AI_JOB_CREATION=true
FEATURE_AI_RESUME_PARSING=true
FEATURE_AI_MATCHING=true

# Búsqueda de talento por lenguaje natural (/admin/talento).
# Módulo transversal y solo para admins. Con este flag en false la ruta queda
# inerte y el resto de la plataforma no se entera.
FEATURE_AI_TALENT_SEARCH=true

# Perfiles que pasan del prefiltro SQL al motor de scoring. No es un filtro de
# calidad: es la barrera para cuando la base crezca. Con unos cientos de hojas
# de vida se puntúa a todo el mundo, que es justo lo que queremos.
TALENT_SEARCH_RECALL_LIMIT=400
TALENT_SEARCH_MAX_RESULTS=60

# ═══════════════════════════════════════════════════
# Pasos de configuración inicial:
#
# 1. Crear proyecto en Supabase (https://app.supabase.com)
# 2. Ejecutar en Supabase SQL Editor: contenido de supabase/migrations/001_initial_schema.sql
# 3. Ejecutar: contenido de supabase/seed.sql (job_areas + usuario admin)
# 4. Activar Google OAuth en Supabase → Authentication → Providers → Google
#    - Añadir redirect URL: ${NEXT_PUBLIC_SITE_URL}/auth/callback
# 5. Crear bucket "cvs" en Supabase Storage (privado, RLS activado)
# 6. Crear cuenta en Resend y verificar el dominio getcompany.co
# 7. Completar este archivo como .env.local con los valores reales
# ═══════════════════════════════════════════════════
